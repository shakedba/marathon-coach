# Postgres (Neon via Vercel Storage). Use the POOLED connection string.
DATABASE_URL=
# App login password (min 8 chars; use a long random one)
APP_PASSWORD=
# Secret for token encryption + session signing (min 16 chars): openssl rand -base64 32
ENCRYPTION_KEY=
# Vercel Cron auth (Vercel sends it automatically): openssl rand -hex 24
CRON_SECRET=
# Strava API app (backup source): https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
